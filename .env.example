# ====================================================================
# 多语种文献翻译与论文研读助手 — 环境变量模板
# 复制本文件为 .env 后填入真实值
# 文档 6.5 节：所有 key 走 .env + 环境变量，不入 git
# ====================================================================

# ---- 阿里云 DashScope API Key（必填，用于 LLM / VLM / Embedding） ----
# 格式：sk-xxxxxxxxxxxxxxxx
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的真实Key替换这里

# ---- Langfuse 调用链追踪（可选，填了启用 Langfuse，没填走 Mock 控制台打印） ----
# 文档 6.1 节：Langfuse 追 LLM 调用链
# LANGFUSE_PUBLIC_KEY=pk-xxxxxx
# LANGFUSE_SECRET_KEY=sk-xxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---- PostgreSQL（含 pgvector，文档 6.1 节"写入 PG"）----
# 本地开发：docker-compose 起的 PG 容器
DATABASE_URL=postgresql://postgres:pg_pw_2024@localhost:5432/paper_assistant

# ---- Redis（可选，文档 4.2 节"KV 长时记忆池"；未配置时用内存 KV 降级）----
REDIS_URL=redis://localhost:6379/0

# ---- 应用配置 ----
APP_LOG_FILE=logs/app.log
APP_ENV=dev   # dev / prod

# ---- FastAPI / Uvicorn ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Streamlit（前端）----
STREAMLIT_PORT=8501
